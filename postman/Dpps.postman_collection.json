{
	"info": {
		"_postman_id": "b99dc6ad-de65-469a-85fb-0f133926dd7a",
		"name": "Dpps",
		"description": "Distributed Payment Processing System API. Select the 'Local' environment and run 'Auth / Get token (user)' first: it stores the access token used by all other requests. The collection can be run as a whole (Runner or Newman); the last folder switches to the read-only user and checks that writes are forbidden.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{Token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Get token (user)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"pm.environment.set(\"Token\", pm.response.json().access_token);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "client_id",
									"value": "payment-client",
									"type": "text"
								},
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								},
								{
									"key": "username",
									"value": "user",
									"type": "text"
								},
								{
									"key": "password",
									"value": "user",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloakUrl}}/realms/payment-system/protocol/openid-connect/token",
							"host": [
								"{{keycloakUrl}}"
							],
							"path": [
								"realms",
								"payment-system",
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Full access: realm roles payments-read and payments-write."
					}
				}
			]
		},
		{
			"name": "Payments",
			"item": [
				{
					"name": "Delete all payments",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{dppsUrl}}/api/payments",
							"host": [
								"{{dppsUrl}}"
							],
							"path": [
								"api",
								"payments"
							]
						},
						"description": "No bounds: deletes every payment."
					}
				},
				{
					"name": "Upload payments",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"All 15 rows stored\", () => pm.expect(pm.response.json().successfullyLoaded).to.eql(15));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{dppsUrl}}/api/payments/upload",
							"host": [
								"{{dppsUrl}}"
							],
							"path": [
								"api",
								"payments",
								"upload"
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "test-data/payments-main.csv"
								}
							]
						},
						"description": "15 valid payments on 2026-02-20 and 2026-02-21."
					}
				},
				{
					"name": "Upload payments with errors",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Valid rows stored, invalid ones reported\", () => {",
									"    const body = pm.response.json();",
									"    pm.expect(body.successfullyLoaded).to.eql(3);",
									"    pm.expect(body.rejected).to.eql(7);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{dppsUrl}}/api/payments/upload",
							"host": [
								"{{dppsUrl}}"
							],
							"path": [
								"api",
								"payments",
								"upload"
							]
						},
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "test-data/payments-with-errors.csv"
								}
							]
						},
						"description": "3 valid rows; the invalid ones are skipped and reported per problem."
					}
				},
				{
					"name": "Get payments (one week)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{dppsUrl}}/api/payments?from=2026-02-20T00:00&to=2026-02-26T23:59:59",
							"host": [
								"{{dppsUrl}}"
							],
							"path": [
								"api",
								"payments"
							],
							"query": [
								{
									"key": "from",
									"value": "2026-02-20T00:00"
								},
								{
									"key": "to",
									"value": "2026-02-26T23:59:59"
								}
							]
						},
						"description": "Both bounds are inclusive; the range may span at most 7 days."
					}
				},
				{
					"name": "Delete payments (time range)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{dppsUrl}}/api/payments?from=2026-02-22T00:00&to=2026-02-22T23:59:59",
							"host": [
								"{{dppsUrl}}"
							],
							"path": [
								"api",
								"payments"
							],
							"query": [
								{
									"key": "from",
									"value": "2026-02-22T00:00"
								},
								{
									"key": "to",
									"value": "2026-02-22T23:59:59"
								}
							]
						},
						"description": "Give both bounds or neither."
					}
				}
			],
			"description": "Runs top to bottom: start from an empty store, upload, read, delete a range."
		},
